# Copy to .env for local development. Never commit real values.
# On Vercel these are set per environment (Production / Preview / Development).

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Used by the app at runtime (server only). On Vercel use the transaction pooler
# (…pooler.supabase.com:6543) — serverless functions open many short connections.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"

# Optional. Used only by drizzle-kit (npm run db:migrate / db:generate / db:studio).
# Session pooler (port 5432) or the direct connection. Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# ── Cloudflare R2 (S3-compatible API) ───────────────────────────────────────
# Server only: presigned uploads, existence checks, deletes.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="audioshelf"

# Public base URL of the bucket's custom domain (CDN). No trailing slash.
# Exposed to the browser: audio and covers are fetched straight from here.
NEXT_PUBLIC_MEDIA_BASE_URL="https://media.example.com"

# ── Admin panel (used from Phase 4) ─────────────────────────────────────────
# Hash of the shared admin password (never the password itself) and the secret
# that signs the 12 h admin session token. Generation commands come with Phase 4.
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# ── Supabase Auth — Google sign-in (used from Phase 6) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Tests (optional) ────────────────────────────────────────────────────────
# Run the Playwright smoke test against a deployed URL instead of a local build.
# PLAYWRIGHT_BASE_URL="https://audioshelf.vercel.app"
# Use the locally installed Chrome instead of Playwright's bundled Chromium.
# PW_CHANNEL="chrome"
