{
  "CORSRules": [
    {
      "AllowedOrigins": ["*"],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedHeaders": ["Range", "If-Range", "If-None-Match", "If-Modified-Since"],
      "ExposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
      "MaxAgeSeconds": 86400
    },
    {
      "AllowedOrigins": ["http://localhost:3000", "https://audioshelf.vercel.app"],
      "AllowedMethods": ["PUT"],
      "AllowedHeaders": ["Content-Type", "Cache-Control", "Content-MD5"],
      "ExposeHeaders": ["ETag"],
      "MaxAgeSeconds": 3600
    }
  ]
}
